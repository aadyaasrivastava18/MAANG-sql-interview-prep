-- Title        : Employee Bonus
-- Difficulty   : Easy
-- Platform     : LeetCode
-- Link         : https://leetcode.com/problems/employee-bonus/
-- Pattern      : LEFT JOIN + NULL Filtering
-- Concepts     : LEFT JOIN, Conditional Filtering
-- ---------------------------------------------------

-- Problem:
-- Report employee name and bonus where:
-- 1. Bonus is less than 1000
-- 2. Employee did not receive a bonus

-- Approach:
-- LEFT JOIN keeps all employees
-- Matching bonus rows are attached when available
-- Filter rows where bonus < 1000
-- Or where bonus is NULL

SELECT
    e.name,
    b.bonus
FROM Employee e
LEFT JOIN Bonus b
    ON e.empId = b.empId
WHERE b.bonus < 1000
   OR b.bonus IS NULL;
