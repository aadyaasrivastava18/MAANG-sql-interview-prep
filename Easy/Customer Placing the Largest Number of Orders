-- Problem:
-- Find the customer_number of the customer
-- who placed the highest number of orders.

-- Approach:
-- Group rows by customer_number
-- Count total orders per customer
-- Sort by count descending
-- Return top customer

SELECT
    customer_number
FROM Orders
GROUP BY customer_number
ORDER BY COUNT(*) DESC
LIMIT 1;
